{
  "name": "@kalada/core",
  "version": "0.1.0",
  "description": "Canonical runtime contracts for the Kalada expression language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/kalada",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "provenance",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./kuery-v1": {
      "import": {
        "types": "./dist/kuery-v1/index.d.ts",
        "default": "./dist/kuery-v1/index.js"
      },
      "require": {
        "types": "./dist/kuery-v1/index.d.cts",
        "default": "./dist/kuery-v1/index.cjs"
      }
    },
    "./kalada-v1": {
      "import": {
        "types": "./dist/kalada-v1/index.d.ts",
        "default": "./dist/kalada-v1/index.js"
      },
      "require": {
        "types": "./dist/kalada-v1/index.d.cts",
        "default": "./dist/kalada-v1/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
