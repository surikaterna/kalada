{
  "name": "@kalada/host",
  "version": "0.1.0",
  "description": "Schema-neutral host environment contracts for Kalada",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/kalada",
    "directory": "packages/host"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config ../../vitest.config.ts src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalada/core": "^0.6.0",
    "@kalada/syntax": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
