{
  "name": "@kalada/projection",
  "version": "0.1.0",
  "description": "Canonical deterministic projection contracts for Kalada",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/kalada",
    "directory": "packages/projection"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "projection-v1.schema.json",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./projection-v1.schema.json": {
      "import": "./projection-v1.schema.json",
      "default": "./projection-v1.schema.json"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalada/core": "^0.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
